# Claude API — necesaria para el agente IA conversacional
ANTHROPIC_API_KEY=tu_api_key_aqui

# Modelo Claude (opcional — default: claude-sonnet-4-6)
# Para alto volumen y bajo costo: claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6

# CORS — orígenes permitidos del panel (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ruta del archivo SQLite local. Default: <repo>/db/aburridont.db
# DB_PATH=/ruta/absoluta/aburridont.db
